PORT=5000

# Comma-separated frontend URLs allowed by CORS (Netlify site URL)
# CLIENT_ORIGIN=https://your-app.netlify.app

# Public frontend URL used in approval email links
# APP_BASE_URL=https://your-app.netlify.app

# Strong secret for JWT tokens (required in production)
# JWT_SECRET=change-me-to-a-long-random-string

# ---- Email (for SRF approval) ----
# If SMTP_HOST/USER/PASS are NOT set, emails go to a fake Ethereal inbox (preview URL only).
# To send REAL emails, fill in below. Example for Gmail (requires App Password):
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youremail@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM="RSi SRF <youremail@gmail.com>"
#
# For Outlook / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youremail@rsystems.com
# SMTP_PASS=your_password
# SMTP_FROM="RSi SRF <youremail@rsystems.com>"
#
# Optional default approver:
# APPROVER_EMAIL=approver@rsystems.com
