PORT=5000

# MongoDB Atlas connection string (database name: /srf)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/srf?retryWrites=true&w=majority

# Comma-separated frontend URLs allowed by CORS (Netlify site URL)

# CLIENT_ORIGIN=https://your-app.netlify.app



# Public frontend URL used in approval email links

# APP_BASE_URL=https://your-app.netlify.app



# Strong secret for JWT tokens (required in production)

# JWT_SECRET=change-me-to-a-long-random-string



# ---- Email (Resend — required for SRF approval emails) ----

# Sign up at https://resend.com and verify your domain (or use onboarding@resend.dev for testing).

#

# RESEND_API_KEY=re_xxxxxxxx

# RESEND_FROM="RSi SRF <onboarding@resend.dev>"

#

# Optional default approver when the UI does not specify To:

# APPROVER_EMAIL=approver@rsystems.com

